# Vaultwarden environment variables
# Copy to .env and fill in values — never commit .env

# Admin panel token (generate with: openssl rand -base64 48)
ADMIN_TOKEN=

# Disable public signups after initial account creation
SIGNUPS_ALLOWED=false

# Domain for Vaultwarden (used in emails)
DOMAIN=https://mitchellnet.local/vault

# SMTP (optional — for email 2FA and notifications)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SSL=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=vaultwarden@mitchellnet.local
